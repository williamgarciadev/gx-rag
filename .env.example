# gx-rag public MCP — environment template.
# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).
#   cp .env.example .env

# Bearer API keys for the public MCP endpoint. Comma-separated, one per client.
# Each key MUST be >= 32 chars or the service refuses to start (fail closed).
# Generate one:  openssl rand -hex 32
# Revoke a client by removing its key and re-deploying.
GX_PUBLIC_API_KEYS=

# Host allowlist (TrustedHost). Must include the public hostname AND localhost
# (the container healthcheck curls http://localhost:8080/health).
GX_ALLOWED_HOSTS=gxrag.wgsoft.com.co,localhost,127.0.0.1

# Bearer keys for the ADMIN Ingestor API (src/api.py). SEPARATE from the public
# keys above on purpose: these grant corpus WRITES (/scrape), so a public read
# key must never open them. Same >= 32 char floor.
# Leave EMPTY and the admin API serves loopback only — enough for local dev,
# and it still shuts out other containers on the shared Docker network.
GX_ADMIN_API_KEYS=

# CORS origins allowed to call the admin API from a browser. NEVER "*": that
# surface sends credentials, and Starlette answers wildcard-plus-credentials by
# echoing the caller's own Origin, which grants every site the curator visits.
GX_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Per-key request budget per minute (429 above this).
GX_RATE_LIMIT_PER_MINUTE=60

# Failed-auth attempts per client IP per minute before throttling (429).
GX_MAX_AUTH_FAILURES_PER_MINUTE=10
